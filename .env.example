# NVIDIA Build API keys (server-only; get them at https://build.nvidia.com).
# The server uses the primary key first and swaps to the secondary key on quota/rate-limit responses.
NVIDIA_API_KEY_PRIMARY=nvapi-primary-key
NVIDIA_API_KEY_SECONDARY=nvapi-secondary-key

# Required server-side HMAC key for public demo buckets. Generate a long random value.
RATE_LIMIT_SECRET=replace-with-a-long-random-rate-limit-secret

# Separate server-side HMAC key for Durable Object account IDs. Do not reuse
# RATE_LIMIT_SECRET and never expose this value to the browser.
ACCOUNT_ID_SECRET=replace-with-a-long-random-account-id-secret

# Separate server-side HMAC key for D1 `users` row IDs (terms consent). Do not
# reuse RATE_LIMIT_SECRET or ACCOUNT_ID_SECRET and never expose it to the browser.
TERMS_USER_ID_SECRET=replace-with-a-long-random-terms-user-id-secret

# Optional comma-separated allowlist for unlimited AI access. Empty means no privileged accounts.
UNLIMITED_AI_EMAILS=
ADMIN_EMAILS=
# Non-secret provider IDs. All three are required when CLODEX_ENABLED=true;
# there is no production fallback ID.
CLODEX_MODEL_FAST=
CLODEX_MODEL_REASONING=
CLODEX_MODEL_PRO=

# Development-only local preview. Production builds reject these flags.
TKLABS_LOCAL_PREVIEW=false
NEXT_PUBLIC_TKLABS_LOCAL_PREVIEW=false

# Optional comma-separated allowlist for administrator actions (revoking another
# account's Clodex access, reviewing all accounts' terms consent at /admin/terms).
# Deliberately separate from UNLIMITED_AI_EMAILS: unlimited AI usage does not imply
# admin power over other users' accounts. Empty means no admin accounts.
# Backward-compatible alias for the primary key (use the explicit names above for two-key rotation).
# NVIDIA_API_KEY=nvapi-primary-key

# Optional legacy provider fallback.
CLODEX_API_KEY=sk-your-api-key
CLODEX_ENABLED=false
CLODEX_GRANT_TTL_DAYS=30
CLODEX_GRANT_VERSION=v2

# TTS quotas are server-side variables. Public defaults are 5 requests/15 min
# and 10,000 Unicode code points/day; privileged accounts use 30 and 100,000.
TTS_REQUEST_LIMIT=5
TTS_DAILY_CHARACTER_QUOTA=10000
TTS_PRIVILEGED_REQUEST_LIMIT=30
TTS_PRIVILEGED_DAILY_CHARACTER_QUOTA=100000

# Optional high-quality speech output through ElevenLabs. If these are unset,
# the chat uses the best matching voice exposed by the browser instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Private code that activates the Clodex catalog for a signed-in account.
# Keep the real value in .env.local / a Cloudflare secret, never in Git.
CLODEX_ACCESS_CODE=replace-with-a-private-access-code

# Auth.js server secret. Generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-secret

# Optional canonical origin used for Google OAuth callbacks. Leave unset for local
# development; Auth.js will use the current request host. Production deployment
# sets this to https://tklabs.uk in the GitHub Actions workflow.
AUTH_URL=

# Google OAuth credentials from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare forwards the public host to the Worker.
AUTH_TRUST_HOST=true

# Optional Cloudflare D1 database ID override for a non-production environment.
# Production defaults to the public routing ID in vite.config.ts.
D1_DATABASE_ID=

# Optional comma-separated allowlist for the hidden Clodex promo-code trigger.
CLODEX_PROMO_EMAILS=
