# NVIDIA Build API keys (server-only; get them at https://build.nvidia.com).
# The server uses the primary key first and swaps to the secondary key on quota/rate-limit responses.
NVIDIA_API_KEY_PRIMARY=nvapi-primary-key
NVIDIA_API_KEY_SECONDARY=nvapi-secondary-key

# Erma Mass Scale provider mesh. Google reuses the server-only Gemini key used by
# grounding. Cerebras and Groq are optional independent overflow/fallback lanes.
ERMA_PROVIDER_MESH_ENABLED=true
GOOGLE_GEMINI_API_KEY=
GOOGLE_FAST_INFERENCE_MODEL=gemini-3.5-flash-lite
GOOGLE_INFERENCE_MODEL=gemini-3.6-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Global admission control. Defaults are intentionally conservative for free-tier
# accounts. Raise RPM/TPM only after checking the live limits shown by each provider
# account. Concurrency protects bursts; RPM and TPM protect provider quotas.
ERMA_ADMISSION_WAIT_MS=1500
ERMA_MAX_ACTIVE_PER_USER=2
ERMA_GOOGLE_FAST_CONCURRENCY=24
ERMA_GOOGLE_CORE_CONCURRENCY=16
ERMA_CEREBRAS_CONCURRENCY=4
ERMA_GROQ_CONCURRENCY=4
ERMA_NVIDIA_CONCURRENCY=8
ERMA_GOOGLE_FAST_RPM=30
ERMA_GOOGLE_CORE_RPM=30
ERMA_CEREBRAS_RPM=30
ERMA_GROQ_RPM=30
ERMA_NVIDIA_RPM=30
ERMA_GOOGLE_FAST_TPM=64000
ERMA_GOOGLE_CORE_TPM=64000
ERMA_CEREBRAS_TPM=64000
ERMA_GROQ_TPM=8000
ERMA_NVIDIA_TPM=64000

# Optional Erma Google Search grounding (preferred web-intelligence provider).
# GOOGLE_GEMINI_API_KEY / GEMINI_API_KEY enables Gemini Interactions API with the
# built-in google_search tool. Keep server-only. Grounding deliberately uses Gemini
# 2.5 Flash / Flash-Lite because Google Search Grounding remains available on their
# free tier; Gemini 3.x stays available separately for ordinary inference above.
GOOGLE_GROUNDING_MODEL=gemini-2.5-flash-lite
GOOGLE_DIRECT_GROUNDING_MODEL=gemini-2.5-flash

# Existing Google Custom Search JSON API customers may use the legacy fallback
# until Google's announced discontinuation date. New customers should use Google
# Search grounding above instead.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional Erma Web Intelligence fallback. If Google grounding/search is not
# configured or temporarily fails, current-information and research routes can
# fall back to Brave Search. Keep server-only.
BRAVE_SEARCH_API_KEY=

# Optional isolated Code Lab runner. The endpoint must be an HTTPS sandbox service
# that enforces network=false, a temporary filesystem, CPU/time/memory/process limits.
# Never point this at the application Worker or a general-purpose host executor.
CODE_SANDBOX_URL=
CODE_SANDBOX_TOKEN=

# Required server-side HMAC key for public demo buckets. Generate a long random value.
RATE_LIMIT_SECRET=replace-with-a-long-random-rate-limit-secret

# Separate server-side HMAC key for Durable Object account IDs. Do not reuse
# RATE_LIMIT_SECRET and never expose this value to the browser.
ACCOUNT_ID_SECRET=replace-with-a-long-random-account-id-secret

# Separate server-side HMAC key for D1 `users` row IDs (terms consent). Do not
# reuse RATE_LIMIT_SECRET or ACCOUNT_ID_SECRET and never expose it to the browser.
TERMS_USER_ID_SECRET=replace-with-a-long-random-terms-user-id-secret

# Optional encrypted Workspace Sync. Leave empty to keep sync disabled. When
# enabled, use a separate random server-only value of at least 32 characters.
WORKSPACE_SYNC_SECRET=
# Optional v2 root for Workspace Sync key rotation. Keep WORKSPACE_SYNC_SECRET
# available while legacy v1 rows may still need authenticated migration.
WORKSPACE_SYNC_SECRET_V2=

# Public legal identity. Keep the preview placeholders in development only.
# Before a commercial launch these values must be reviewed and configured.
NEXT_PUBLIC_TKLAB_OPERATOR_NAME=
NEXT_PUBLIC_TKLAB_LEGAL_CONTACT=
NEXT_PUBLIC_TKLAB_JURISDICTION=
# CI/deploy may set this only after the real legal identity above is configured.
TKLABS_COMMERCIAL_LAUNCH=false

# Optional comma-separated allowlist for unlimited AI access. Empty means no privileged accounts.
UNLIMITED_AI_EMAILS=
ADMIN_EMAILS=
# Non-secret provider IDs. All three are required when CLODEX_ENABLED=true;
# there is no production fallback ID.
CLODEX_MODEL_FAST=
CLODEX_MODEL_REASONING=
CLODEX_MODEL_PRO=

# Development-only local preview. Production builds reject these flags.
TKLABS_LOCAL_PREVIEW=false
NEXT_PUBLIC_TKLABS_LOCAL_PREVIEW=false

# Optional comma-separated allowlist for administrator actions (revoking another
# account's Clodex access, reviewing all accounts' terms consent at /admin/terms).
# Deliberately separate from UNLIMITED_AI_EMAILS: unlimited AI usage does not imply
# admin power over other users' accounts. Empty means no admin accounts.
# Backward-compatible alias for the primary key (use the explicit names above for two-key rotation).
# NVIDIA_API_KEY=nvapi-primary-key

# Optional legacy provider fallback.
CLODEX_API_KEY=sk-your-api-key
CLODEX_ENABLED=false
CLODEX_GRANT_TTL_DAYS=30
CLODEX_GRANT_VERSION=v2

# TTS quotas are server-side variables. Public defaults are 5 requests/15 min
# and 10,000 Unicode code points/day; privileged accounts use 30 and 100,000.
TTS_REQUEST_LIMIT=5
TTS_DAILY_CHARACTER_QUOTA=10000
TTS_PRIVILEGED_REQUEST_LIMIT=30
TTS_PRIVILEGED_DAILY_CHARACTER_QUOTA=100000

# Optional high-quality speech output through ElevenLabs. If these are unset,
# the chat uses the best matching voice exposed by the browser instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Private code that activates the Clodex catalog for a signed-in account.
# Keep the real value in .env.local / a Cloudflare secret, never in Git.
CLODEX_ACCESS_CODE=replace-with-a-private-access-code

# Auth.js server secret. Generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-secret

# Optional canonical origin used for Google OAuth callbacks. Leave unset for local
# development; Auth.js will use the current request host. Production deployment
# sets this to https://tklabs.uk in the GitHub Actions workflow.
AUTH_URL=

# Google OAuth credentials from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare forwards the public host to the Worker.
AUTH_TRUST_HOST=true

# Optional Cloudflare D1 database ID override for a non-production environment.
# Production defaults to the public routing ID in vite.config.ts.
D1_DATABASE_ID=

# Optional comma-separated allowlist for the hidden Clodex promo-code trigger.
CLODEX_PROMO_EMAILS=
