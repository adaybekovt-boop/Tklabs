{
  "name": "tkai",
  "version": "0.25.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:unit": "tsx --test tests/behavior.test.ts",
    "test:integration": "node --import tsx --import ./tests/register-cloudflare-loader.mjs --test tests/*.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "release:check": "node scripts/check-release-consistency.mjs",
    "migration:safety": "node scripts/check-migration-safety.mjs",
    "trust:legal": "node scripts/check-legal-consistency.mjs",
    "trust:policy": "node scripts/check-policy-consistency.mjs",
    "trust:check": "node scripts/check-trust-consistency.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "smoke:production": "node scripts/smoke-test-production.mjs",
    "load:erma": "node scripts/load-test-erma.mjs",
    "check": "npm run typecheck && npm run lint && npm run security:secrets && npm run migration:safety && npm run trust:legal && npm run trust:policy && npm run trust:check && npm run release:check && npm test && npm run build && npm run perf:budget",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-d1.mjs",
    "cloudflare:check-secrets": "node scripts/check-cloudflare-secrets.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.43.0",
    "katex": "^0.16.22",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.7",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
